# ==============================================================================
# ManuMaker Environment Configuration
# ==============================================================================

# Supabase Configuration
# Replace these with your project values from https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Application Base URL (Used for QR code links and SEO metadata)
NEXT_PUBLIC_APP_URL=https://manumaker.in

# Meta Ads / Facebook Pixel Integration
# Get your Pixel ID from Meta Events Manager (e.g. 123456789012345)
NEXT_PUBLIC_META_PIXEL_ID=

# Facebook Domain Verification Code (from Meta Business Suite -> Brand Safety -> Domains)
NEXT_PUBLIC_FACEBOOK_DOMAIN_VERIFICATION=
